{
  "name": "dsh-model-port",
  "version": "1.0.0",
  "description": "Import and export one custom model provider's API configuration from Settings > Models.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "model-provider"
  ],
  "license": "MIT",
  "author": "jlshix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlshix/dsh-model-port.git"
  },
  "homepage": "https://github.com/jlshix/dsh-model-port#readme",
  "bugs": {
    "url": "https://github.com/jlshix/dsh-model-port/issues"
  },
  "type": "module",
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.test.mjs",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
